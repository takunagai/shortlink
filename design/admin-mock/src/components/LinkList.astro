---
// LinkList ─ 一覧テーブル（デスクトップ）+ カードリスト（モバイル）。
// 実装では loading / empty / error / list の4状態を内包する。
type SampleLink = {
  id: number;
  slug: string;
  url: string;
  clicks: number;
  created_at: string;
};
const { links, origin = "https://slk.example.app" } = Astro.props as {
  links: SampleLink[];
  origin?: string;
};
const hasLinks = links && links.length > 0;
---

<section
  class="overflow-hidden rounded-card border border-border bg-surface shadow-card"
  aria-labelledby="list-heading"
>
  <div class="flex items-center justify-between border-b border-border px-6 py-4">
    <h2 id="list-heading" class="text-section leading-tight font-bold text-ink">
      リンク一覧
    </h2>
    <span class="text-meta text-muted">
      {hasLinks ? `${links.length} 件` : ""}
    </span>
  </div>

  {
    hasLinks ? (
      <>
        {/* デスクトップ: テーブル */}
        <div class="hidden md:block">
          <table class="w-full border-collapse text-body">
            <thead>
              <tr class="border-b border-border bg-canvas text-left">
                <th scope="col" class="px-6 py-3 text-meta font-bold text-muted">
                  slug
                </th>
                <th scope="col" class="px-6 py-3 text-meta font-bold text-muted">
                  元 URL
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-right text-meta font-bold text-muted"
                >
                  クリック
                </th>
                <th scope="col" class="px-6 py-3 text-meta font-bold text-muted">
                  作成日時
                </th>
                <th scope="col" class="px-6 py-3 text-meta font-bold text-muted">
                  <span class="sr-only">操作</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {links.map((l) => (
                <tr class="border-b border-border last:border-b-0 hover:bg-canvas/60">
                  <td class="px-6 py-3 align-middle">
                    <a
                      href={`${origin}/${l.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-mono text-accent underline-offset-2 hover:underline"
                    >
                      /{l.slug}
                    </a>
                  </td>
                  <td class="max-w-[28rem] px-6 py-3 align-middle">
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={l.url}
                      class="block truncate text-ink hover:text-accent hover:underline"
                    >
                      {l.url}
                    </a>
                  </td>
                  <td class="px-6 py-3 text-right align-middle tabular-nums text-ink">
                    {l.clicks.toLocaleString("ja-JP")}
                  </td>
                  <td class="px-6 py-3 text-meta align-middle tabular-nums text-muted">
                    {l.created_at}
                  </td>
                  <td class="px-6 py-3 text-right align-middle">
                    <button
                      type="button"
                      class="rounded-control border border-border px-3 py-1.5 text-meta text-danger transition-colors hover:border-danger hover:bg-danger-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                      aria-label={`/${l.slug} を削除`}
                    >
                      削除
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* モバイル: カードリスト */}
        <ul class="divide-y divide-border md:hidden">
          {links.map((l) => (
            <li class="space-y-3 p-4">
              <div class="flex items-start justify-between gap-3">
                <a
                  href={`${origin}/${l.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-mono text-accent break-all underline-offset-2 hover:underline"
                >
                  /{l.slug}
                </a>
                <button
                  type="button"
                  class="shrink-0 rounded-control border border-border px-3 py-1.5 text-meta text-danger transition-colors hover:border-danger hover:bg-danger-subtle"
                  aria-label={`/${l.slug} を削除`}
                >
                  削除
                </button>
              </div>
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                title={l.url}
                class="block break-all text-ink hover:text-accent hover:underline"
              >
                {l.url}
              </a>
              <dl class="flex gap-4 text-meta text-muted">
                <div>
                  <dt class="inline">クリック </dt>
                  <dd class="inline tabular-nums text-ink">
                    {l.clicks.toLocaleString("ja-JP")}
                  </dd>
                </div>
                <div>
                  <dt class="inline">作成 </dt>
                  <dd class="inline tabular-nums text-ink">{l.created_at}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div class="px-6 py-16 text-center">
        <p class="text-body text-ink">
          【コピー待ち: 空状態メッセージ ─「まだリンクがありません。」、20字程度】
        </p>
        <p class="mt-2 text-meta text-muted">
          【コピー待ち: 空状態補足 ─「上のフォームから作成してください」】
        </p>
      </div>
    )
  }
</section>
