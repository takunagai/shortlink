---
// LinkCreateForm ─ デザインカンプ用の静的マークアップ。
// 実装（React 19 island）では onSubmit で POST /api/links を呼び、
// 成功時に親 AdminPage へ通知して一覧を再取得する。
const { origin = "https://slk.example.app" } = Astro.props;
---

<section
  class="rounded-card border border-border bg-surface shadow-card"
  aria-labelledby="create-heading"
>
  <div class="border-b border-border px-6 py-4">
    <h2 id="create-heading" class="text-section leading-tight font-bold text-ink">
      新しいリンク
    </h2>
    <p class="mt-1 text-meta text-muted">
      【コピー待ち: フォーム補足 ─「短縮 URL を作成します」等、20字程度。省略可】
    </p>
  </div>

  <form class="space-y-4 p-6" action="#" method="post" novalidate>
    <div>
      <label for="url" class="block text-body font-bold text-ink">
        URL <span class="text-danger" aria-hidden="true">*</span>
        <span class="sr-only">（必須）</span>
      </label>
      <input
        id="url"
        name="url"
        type="url"
        required
        placeholder="https://example.com/very/long/url"
        autocomplete="off"
        spellcheck="false"
        class="mt-2 block w-full rounded-control border border-border bg-surface px-3 py-2 text-body text-ink placeholder:text-subtle focus:border-border-strong"
      />
      <p class="mt-2 hidden text-meta text-danger" role="alert">
        【コピー待ち: URL バリデーションエラー ─「URL を入力してください」等】
      </p>
    </div>

    <div class="flex flex-col gap-4 md:flex-row md:items-end">
      <div class="flex-1">
        <label for="slug" class="block text-body font-bold text-ink">
          slug
          <span class="text-meta font-normal text-muted">（任意）</span>
        </label>
        <div class="mt-2 flex items-center rounded-control border border-border bg-surface focus-within:border-border-strong">
          <span class="select-none border-r border-border px-3 py-2 text-body text-muted">
            {origin}/
          </span>
          <input
            id="slug"
            name="slug"
            type="text"
            placeholder="my-link"
            autocomplete="off"
            spellcheck="false"
            class="w-full bg-transparent px-3 py-2 text-body text-ink placeholder:text-subtle focus:outline-none"
          />
        </div>
        <p class="mt-2 text-meta text-muted">
          【コピー待ち: slug 補足 ─「省略時は自動生成」、10字程度】
        </p>
        <p class="mt-2 hidden text-meta text-danger" role="alert">
          【コピー待ち: slug 重複エラー ─「この slug は既に使われています」】
        </p>
      </div>

      <button
        type="submit"
        class="shrink-0 rounded-control bg-accent px-6 py-2 text-body font-bold text-white transition-colors hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        作成
      </button>
    </div>
  </form>
</section>
